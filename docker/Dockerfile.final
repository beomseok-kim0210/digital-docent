# =============================================================================
# DD SOAP — FINAL image, built from the canonical LOCK SET.
#
# Not a retag of the candidate. Every distribution comes from an exact pin
# generated by docker/build_final_lock.py out of the candidate manifest, so
# this build is a from-scratch proof that the lock set reconstructs the
# environment on its own.
#
# Differences from Dockerfile.v2, all of them removals:
#   - no derive_tier2.sh: nothing is left unpinned, so nothing needs filtering
#   - no constraints file: constraints exist to bound unpinned packages
#   - no drift-correction layer: corrections are folded into the lock
#
# Build requires NO GPU. Every CUDA-linked check runs on the pod later.
#
#   docker build --no-cache -f Dockerfile.final -t dd-soap:qka2-repro-v1 .
# =============================================================================

# Tag not re-pushed since 2023-11-10 (Docker Hub), which precedes the
# 2026-09-02 pod run, so this is the image the pod ran.
# provenance: reported_by_source (Docker Hub) + derived (tag immutable since).
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Native-build controls, referenced inline so they never leak into the runtime.
# FORCE_CUDA=1 is technically required on a GPU-less builder: pytorch3d,
# torch_scatter and torch_sparse gate their CUDA branch on
# torch.cuda.is_available(), and without it they emit CPU-only artifacts that
# still import and still report the correct version.
ARG MAX_JOBS=2
ARG TORCH_CUDA_ARCH_LIST=8.6
ARG FORCE_CUDA=1

# -----------------------------------------------------------------------------
# 1. OS packages
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 python3.10-dev python3.10-venv python3-pip \
      build-essential cmake ninja-build git wget curl unzip ca-certificates \
      mesa-common-dev libegl1-mesa-dev libgles2-mesa-dev mesa-utils \
      libx11-dev libopenblas-dev \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# LOCK SET LAYER 1 — build tools.
# The pod upgraded pip only; setuptools stayed at the ensurepip-bundled 59.6.0.
# Pinned explicitly and asserted later, so a change to Ubuntu's bundled wheel
# fails the build loudly instead of drifting silently.
# -----------------------------------------------------------------------------
RUN python3 -m venv /opt/soapenv
ENV VIRTUAL_ENV=/opt/soapenv
ENV PATH=/opt/soapenv/bin:$PATH

RUN pip install --no-cache-dir --upgrade "pip==26.2.1"
RUN pip install --no-cache-dir "setuptools==59.6.0" "wheel==0.48.0" "ninja==1.13.2"

# -----------------------------------------------------------------------------
# LOCK SET LAYER 2 — torch tier. Own invocation: the --no-build-isolation
# builds below import torch at build time and pip guarantees no ordering
# within a single resolution pass.
# -----------------------------------------------------------------------------
COPY requirements-dd-torch.txt /opt/dd-lock/
RUN pip install --no-cache-dir -r /opt/dd-lock/requirements-dd-torch.txt

# -----------------------------------------------------------------------------
# LOCK SET LAYER 3 — dlib, isolated.
# It failed inside the aggregate build on the pod and succeeded standalone.
# Resource exhaustion was hypothesised and DISPROVEN by measurement (437 GB
# free, 96 cores). ROOT CAUSE UNKNOWN; this ordering is a mitigation, not a
# proven fix.
# -----------------------------------------------------------------------------
RUN MAX_JOBS=${MAX_JOBS} \
    pip install --no-cache-dir --no-build-isolation "dlib==20.0.1"

# -----------------------------------------------------------------------------
# LOCK SET LAYER 4 — the canonical lock: four git packages at exact SHAs plus
# every remaining PyPI distribution at its exact measured version.
# Installed WITH dependency resolution on purpose: every transitive is pinned,
# so if the lock is internally inconsistent this build fails here rather than
# producing a quietly different image.
# -----------------------------------------------------------------------------
COPY requirements-dd-lock.txt /opt/dd-lock/
RUN MAX_JOBS=${MAX_JOBS} \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    FORCE_CUDA=${FORCE_CUDA} \
    pip install --no-cache-dir --no-build-isolation \
      -r /opt/dd-lock/requirements-dd-lock.txt

# -----------------------------------------------------------------------------
# LOCK SET LAYER 5 — smplx, --no-deps, after nvdiffrast exists.
# Its setup.py at the pinned SHA declares
#   'nvdiffrast @ git+https://github.com/NVlabs/nvdiffrast.git'
# with no revision. Resolving it pulls mutable HEAD, which conflicts with the
# verified nvdiffrast revision; pip constraints do not apply to direct URL
# requirements. Upstream source is NOT patched and the smplx SHA is unchanged.
# Its full dependency closure (8 entries, read from source) is supplied by
# layers 2 and 4.
# -----------------------------------------------------------------------------
ARG SMPLX_SHA=05e521dd26b92f3d6e0d6462e58fb15b7d1dbfbe
RUN pip install --no-cache-dir --no-build-isolation --no-deps \
      "smplx @ git+https://github.com/TingtingLiao/smplx.git@${SMPLX_SHA}"

# -----------------------------------------------------------------------------
# SOAP source at the frozen revision. The source tree is never modified.
# -----------------------------------------------------------------------------
ARG SOAP_SHA=c94f718efbdf0abdd8bbe9e34e67737744f1310f
RUN git clone https://github.com/TingtingLiao/soap.git /opt/soap \
 && git -C /opt/soap checkout ${SOAP_SHA} \
 && git -C /opt/soap rev-parse HEAD | tee /opt/dd-lock/soap_source_sha.txt \
 && [ "$(git -C /opt/soap rev-parse HEAD)" = "${SOAP_SHA}" ]
WORKDIR /opt/soap

# -----------------------------------------------------------------------------
# VALIDATION — GPU-free. Metadata assertions plus CPU-safe imports, then full
# lock-set coverage: every installed distribution must be covered by exactly
# one layer, every git commit must match its pin, and no mutable git ref may
# remain. torch.cuda.is_available() is deliberately not consulted.
# -----------------------------------------------------------------------------
COPY lockset.json requirements-dd-lock.provenance.json /opt/dd-lock/
COPY validate_lock.py validate_runtime.py extract_manifest.py \
     verify_lock_coverage.py /opt/dd-lock/
RUN python /opt/dd-lock/validate_lock.py
RUN python /opt/dd-lock/verify_lock_coverage.py \
      /opt/dd-lock/lockset.json \
      /opt/dd-lock/requirements-dd-lock.txt \
      ${SOAP_SHA}

RUN pip freeze > /opt/dd-lock/pip-freeze-final.txt \
 && pip list --format=freeze > /opt/dd-lock/pip-list-final.txt \
 && wc -l /opt/dd-lock/pip-freeze-final.txt

# -----------------------------------------------------------------------------
# Runtime environment. Caches, inputs and outputs live on the mounted volume.
#
# Deliberately NOT baked in, and this is a content-safety requirement:
#   - download.sh model assets (2.0 GB): FLAME/EMOCA non-commercial licence
#     terms make baking them redistribution. Acquisition stays a runtime step.
#   - no portrait input, no generated output, no HF/GitHub/RunPod credentials,
#     no private data of any kind.
# -----------------------------------------------------------------------------
ENV HF_HOME=/workspace/hf_cache
ENV TORCH_HOME=/workspace/torch_cache
ENV SOAP_HOME=/opt/soap
ENV DD_LOCK_DIR=/opt/dd-lock
CMD ["/bin/bash"]
