# =============================================================================
# DD SOAP — Dockerfile V2   (deterministic lock recovery)
#
# V1 installed SOAP's unpinned requirements.txt, then uninstalled and overwrote
# the broken results. V2 never installs a known-bad revision: every dependency
# with a recovered version or SHA is pinned up front, and the residual is
# constrained so it cannot move a locked pin.
#
# Docker build requires NO GPU. Every CUDA-linked check is deferred to
# validate_runtime.py (stages S0/S1/S2) on the pod.
#
# Reconstructs the environment measured on the RunPod A40 pod, 2026-09-02.
# Build:
#   docker build -f Dockerfile.v2 -t dd-soap:v2 .
# =============================================================================

# The tag has not been re-pushed since 2023-11-10 (Docker Hub last_updated),
# which precedes the 2026-09-02 run, so this digest is the image the pod ran.
# provenance: reported_by_source (Docker Hub) + derived (tag immutable since).
# Pin by digest once a clean-room `docker inspect` confirms it:
#   FROM nvidia/cuda@sha256:21196d81f56b48dbee70494d5f10322e1a77cc47ffe202a3bf68eab81533c20f
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# -----------------------------------------------------------------------------
# 0. Native-build controls. Referenced inline by the compiling RUN steps, never
#    promoted to ENV, so none of this leaks into the runtime container.
#
#    DECLARED DEVIATION FROM THE 2026-09-02 POD RUN — same result, different
#    mechanism. The pod had an A40 attached during `pip install`, so:
#
#      FORCE_CUDA            unset, but torch.cuda.is_available() was True, so
#                            pytorch3d / torch_scatter / torch_sparse all took
#                            their CUDA branch. A GPU-less builder takes the CPU
#                            branch instead and silently produces a CPU-ONLY
#                            artifact that still imports and still reports the
#                            right version — a wrong image that passes every
#                            metadata check. FORCE_CUDA=1 is therefore
#                            TECHNICALLY REQUIRED here, not a convenience.
#      TORCH_CUDA_ARCH_LIST  unset, and torch auto-detected the attached device:
#                            A40 is sm_86. Pinning 8.6 reproduces exactly that
#                            arch set without a device present.
#      MAX_JOBS              unset; torch used os.cpu_count() = 96 on the pod.
#                            Build parallelism does not change the emitted
#                            binary, only peak RAM. Safe to lower.
# -----------------------------------------------------------------------------
ARG MAX_JOBS=2
ARG TORCH_CUDA_ARCH_LIST=8.6
ARG FORCE_CUDA=1

# -----------------------------------------------------------------------------
# 1. OS packages
#      python3.10-dev   without it torch_sparse / torch_scatter / dlib all die
#                       with "fatal error: Python.h: No such file or directory"
#      python3.10-venv  absent from the base image; `python3 -m venv` fails
#      unzip            download.sh calls it and it is absent
#      mesa / EGL       required by the SOAP README
#    All three absences above are measured from the 2026-09-02 run.
#    apt versions are NOT pinned — see REPRODUCIBILITY_GAPS G-1.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 python3.10-dev python3.10-venv python3-pip \
      build-essential cmake ninja-build git wget curl unzip ca-certificates \
      mesa-common-dev libegl1-mesa-dev libgles2-mesa-dev mesa-utils \
      libx11-dev libopenblas-dev \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 2. venv + build tooling — FROZEN. This is the V1 correction.
#
#    V1 had:   pip install --upgrade pip setuptools wheel ninja
#    That is NOT a reproduction. Recovered from the execution log, the
#    successful run upgraded pip ONLY:
#        python3 -m venv /root/soapenv
#        pip install -q --upgrade pip           -> pip 26.2.1
#        pip install -q setuptools wheel ninja  -> NO --upgrade, so the
#              ensurepip-bundled setuptools 59.6.0 was left in place, while
#              wheel and ninja were absent and installed fresh.
#    V1's --upgrade would have pulled setuptools ~80.x instead of 59.6.0.
#
#    All four versions below are measured_from_execution_log. They are pinned
#    explicitly AND asserted, so a future change to Ubuntu's bundled ensurepip
#    wheel fails the build loudly instead of drifting silently.
# -----------------------------------------------------------------------------
RUN python3 -m venv /opt/soapenv
ENV VIRTUAL_ENV=/opt/soapenv
ENV PATH=/opt/soapenv/bin:$PATH

RUN pip install --no-cache-dir --upgrade "pip==26.2.1"
RUN pip install --no-cache-dir "setuptools==59.6.0" "wheel==0.48.0" "ninja==1.13.2"

# -----------------------------------------------------------------------------
# 3. TIER 0 — core runtime, frozen by the Human runbook.
#    Its own pip invocation: the --no-build-isolation builds that follow import
#    torch at build time, and pip gives no ordering guarantee within a single
#    resolution pass.
# -----------------------------------------------------------------------------
COPY requirements-dd-torch.txt /opt/dd-lock/
RUN pip install --no-cache-dir -r /opt/dd-lock/requirements-dd-torch.txt

# -----------------------------------------------------------------------------
# 4. dlib — installed alone, ahead of everything else that compiles.
#
#    Measured: dlib failed inside the aggregate requirements build
#    (cmake --build . -- -j96 -> gmake Error 2; pip truncated the compiler
#    error) and succeeded when run on its own. Its failure also rolled back the
#    seven packages that had already built, because pip installs atomically.
#
#    ROOT CAUSE IS UNKNOWN. Resource exhaustion was hypothesised and DISPROVEN
#    by measurement (503 GB total / 437 GB available, nproc 96, affinity 96).
#    This ordering reproduces the sequence that worked. It is a MITIGATION,
#    not a proven fix. See REPRODUCIBILITY_GAPS G-3.
# -----------------------------------------------------------------------------
#    dlib does not consult FORCE_CUDA; its CMake detects the CUDA toolkit, which
#    the devel base image provides with or without a device.
RUN MAX_JOBS=${MAX_JOBS} \
    pip install --no-cache-dir --no-build-isolation "dlib==20.0.1"

# -----------------------------------------------------------------------------
# 5. TIER 1 — the deterministic lock: git revisions + drift corrections.
#    No unpinned git HEAD is ever installed, so the nvdiffrast
#    "UNKNOWN 0.0.0" state is never entered and never has to be cleaned up.
# -----------------------------------------------------------------------------
#    pytorch3d, torch_sparse and torch_scatter compile CUDA kernels here. See
#    layer 0 for why FORCE_CUDA=1 is required on a GPU-less builder.
COPY requirements-dd-lock.txt constraints-dd.txt /opt/dd-lock/
RUN MAX_JOBS=${MAX_JOBS} \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    FORCE_CUDA=${FORCE_CUDA} \
    pip install --no-cache-dir --no-build-isolation \
      -r /opt/dd-lock/requirements-dd-lock.txt

# -----------------------------------------------------------------------------
# 6. SOAP source at the frozen revision. The source tree is never modified.
# -----------------------------------------------------------------------------
ARG SOAP_SHA=c94f718efbdf0abdd8bbe9e34e67737744f1310f
RUN git clone https://github.com/TingtingLiao/soap.git /opt/soap \
 && git -C /opt/soap checkout ${SOAP_SHA} \
 && git -C /opt/soap rev-parse HEAD | tee /opt/dd-lock/soap_source_sha.txt \
 && [ "$(git -C /opt/soap rev-parse HEAD)" = "${SOAP_SHA}" ]
WORKDIR /opt/soap

# -----------------------------------------------------------------------------
# 7. TIER 2 — the residual of SOAP requirements.txt.
#
#    Derived by filtering, never by editing the upstream file. Everything
#    Tier 0/1 owns is removed, so no unpinned git URL and no package with a
#    known-good version can be reinstalled or downgraded here.
#
#    Installed under -c constraints-dd.txt: a Tier 2 package that transitively
#    demands a different version of a locked package fails the resolver at
#    BUILD time (free, no GPU) instead of at RUN time on a paid pod.
#
#    Partition verified locally against requirements.txt @ c94f718:
#      22 removed + 29 retained = 51 source lines, exact, nothing lost.
#    Those 29 remain genuinely unpinned. See REPRODUCIBILITY_GAPS G-2.
#    Both the removed and the retained sets are printed for audit.
# -----------------------------------------------------------------------------
COPY derive_tier2.sh /opt/dd-lock/
RUN sh /opt/dd-lock/derive_tier2.sh /opt/soap/requirements.txt /opt/dd-lock/tier2.txt \
 && MAX_JOBS=${MAX_JOBS} \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    FORCE_CUDA=${FORCE_CUDA} \
    pip install --no-cache-dir --no-build-isolation \
      -c /opt/dd-lock/constraints-dd.txt \
      -r /opt/dd-lock/tier2.txt

# -----------------------------------------------------------------------------
# 8. BUILD-TIME VALIDATION — no GPU required.
#    Metadata assertions for all 27 locked packages, plus real imports for the
#    ten modules that do not link CUDA at import time. pytorch3d,
#    nvdiffrast.torch, torch_sparse and torch_scatter are checked on the pod.
# -----------------------------------------------------------------------------
COPY validate_lock.py validate_runtime.py extract_manifest.py /opt/dd-lock/
RUN python /opt/dd-lock/validate_lock.py

# Freeze the built state so the next build can be diffed against this one.
RUN pip freeze > /opt/dd-lock/pip-freeze-built.txt \
 && pip list --format=freeze > /opt/dd-lock/pip-list-built.txt \
 && echo "--- built lock summary ---" \
 && wc -l /opt/dd-lock/pip-freeze-built.txt

# -----------------------------------------------------------------------------
# 9. Runtime environment. Caches and outputs live on the mounted volume, so a
#    pod teardown no longer destroys them.
#
#    download.sh calls bare `pip` / `gdown` / `unzip`; the venv is on PATH.
#    download.sh is deliberately NOT baked in: its 2.0 GB payload carries
#    FLAME / EMOCA non-commercial licence terms, and baking it into an image
#    would constitute redistribution.
# -----------------------------------------------------------------------------
ENV HF_HOME=/workspace/hf_cache
ENV TORCH_HOME=/workspace/torch_cache
ENV SOAP_HOME=/opt/soap
ENV DD_LOCK_DIR=/opt/dd-lock
CMD ["/bin/bash"]
